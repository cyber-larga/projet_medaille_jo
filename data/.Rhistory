# --- Génération des données simulées ---
set.seed(123)   # pour reproductibilité
# --- Génération des données simulées ---
set.seed(123)   # pour reproductibilité
n <- 50
# X1 et X3 ~ N(0,1) indépendantes
X1 <- rnorm(n, mean = 0, sd = 1)
X3 <- rnorm(n, mean = 0, sd = 1)
# --- 1. Nuage des individus ---
plot(X1, X3, pch = 19, col = "steelblue",
xlab = "X1", ylab = "X3",
main = "Nuage des individus (X1,X3 non corrélés)")
abline(h=0, v=0, col="grey")
# --- 2. Cercle des corrélations ---
# Pour représenter les variables X1 et X3 centrées-réduites
# elles sont sur le cercle unité et orthogonales
theta <- seq(0, 2*pi, length.out = 200)
plot(cos(theta), sin(theta), type = "l", lwd = 2, col = "darkgrey",
asp = 1, xlab = "Axe 1", ylab = "Axe 2",
main = "Cercle des corrélations")
arrows(0,0,1,0, col="red", lwd=2, length=0.1)   # X1
arrows(0,0,0,1, col="blue", lwd=2, length=0.1)  # X3
text(1.1,0,"X1", col="red")
text(0,1.1,"X3", col="blue")
# Corrélation forte positive
x <- rnorm(50)
y <- 2*x + rnorm(50, sd=0.2)
cor(x, y)   # proche de 1
# Corrélation forte négative
y2 <- -3*x + rnorm(50, sd=0.2)
cor(x, y2)  # proche de -1
# Pas de corrélation
z <- rnorm(50)
cor(x, z)   # proche de 0
setwd("~/Documents/GitHub/projet_medaille_jo/data")
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(purrr)
# ------------------------------------------------------------------------------
# 1. FONCTION DE NETTOYAGE UNIVERSELLE (Pour les fichiers Banque Mondiale)
# ------------------------------------------------------------------------------
clean_wb_data <- function(filepath, var_name) {
# On saute les 4 premières lignes de métadonnées
df <- read_csv(filepath, skip = 4, show_col_types = FALSE) %>%
# On supprime les colonnes inutiles
select(-any_of(c("Indicator Name", "Indicator Code", "Unnamed: 69"))) %>%
# On pivote : les années (colonnes) deviennent des lignes
pivot_longer(cols = matches("^\\d{4}$"),
names_to = "Year",
values_to = var_name) %>%
# Conversion et renommage
mutate(Year = as.numeric(Year)) %>%
rename(ISO3 = `Country Code`, Country_Name = `Country Name`) %>%
# On nettoie les NA sur le code pays
filter(!is.na(ISO3)) %>%
select(ISO3, Year, all_of(var_name))
return(df)
}
print("Chargement du PIB...")
df_gdp <- clean_wb_data("GDP current US$.csv", "GDP_USD")
print("Chargement des Dépenses de Santé...")
df_sante <- clean_wb_data("Dépenses Courantes de Santé (% PIB).csv", "Health_Exp_Percent_GDP")
print("Chargement de la Population...")
# C'est le nouveau fichier que tu viens d'envoyer
df_pop <- clean_wb_data("world_population.csv", "Population_Total")
print("Chargement du Régime Politique...")
# Attention au séparateur ";" et à la virgule décimale
df_politique <- read_delim("regime_politique_par_pays.csv", delim = ";", show_col_types = FALSE) %>%
select(ccodealp, year, p_polity2) %>%
rename(ISO3 = ccodealp, Year = year, Polity_Score = p_polity2) %>%
# Correction : on remplace la virgule par un point et on convertit en numérique
mutate(Polity_Score = as.numeric(str_replace(Polity_Score, ",", "."))) %>%
filter(!is.na(ISO3))
print("Chargement de l'Activité Physique (OMS)...")
df_activite <- read_csv("activite_physique_ado.csv", show_col_types = FALSE) %>%
filter(Dim1 == "Both sexes") %>% # On prend la moyenne mixte
select(SpatialDimValueCode, Period, FactValueNumeric) %>%
rename(ISO3 = SpatialDimValueCode, Year = Period, Inactivity_Adolescents_Percent = FactValueNumeric)
print("Création des Pays Hôtes...")
# Création manuelle (plus sûr que le fichier RTF corrompu)
df_host <- data.frame(
Year = c(2000, 2004, 2008, 2012, 2016, 2020, 2024),
ISO3 = c("AUS", "GRC", "CHN", "GBR", "BRA", "JPN", "FRA"),
Is_Host = 1
)
print("Fusion de toutes les bases...")
liste_dfs <- list(df_gdp, df_pop, df_sante, df_politique, df_activite, df_host)
df_final <- liste_dfs %>%
reduce(full_join, by = c("ISO3", "Year")) %>%
arrange(ISO3, Year)
# Remplacer les NA de "Is_Host" par 0
df_final$Is_Host[is.na(df_final$Is_Host)] <- 0
# --- FEATURE ENGINEERING (Création de nouvelles variables) ---
# 1. PIB par Habitant (Plus pertinent que le PIB total)
df_final <- df_final %>%
mutate(GDP_per_Capita = GDP_USD / Population_Total)
# 2. Dépenses de Santé par Habitant (En Dollars réels)
# Car 10% du PIB en France != 10% du PIB en Algérie en valeur absolue
df_final <- df_final %>%
mutate(Health_Exp_per_Capita_USD = GDP_per_Capita * (Health_Exp_Percent_GDP / 100))
# 3. Logarithmes (Pour ton modèle économétrique)
# Pour linéariser les distributions très étalées (comme le PIB ou la Pop)
df_final <- df_final %>%
mutate(
Log_Population = log(Population_Total),
Log_GDP_per_Capita = log(GDP_per_Capita)
)
# ------------------------------------------------------------------------------
# 4. EXPORT
# ------------------------------------------------------------------------------
write.csv(df_final, "Dataset_Explicatif_JO_Complet.csv", row.names = FALSE)
print("TERMINE ! Le fichier 'Dataset_Explicatif_JO_Complet.csv' est prêt.")
print(head(df_final))
setwd("~/Documents/GitHub/projet_medaille_jo/data")
library(dplyr)
# 1. Charger la base complète (celle créée à l'étape précédente)
df <- read.csv("Dataset_Explicatif_JO_Complet.csv")
# 2. Filtrer sur les 10 dernières années (2014-2024)
# On prend large pour maximiser le nombre de données disponibles (pour gérer les NA)
df_10ans <- df %>%
filter(Year >= 2014 & Year <= 2024)
# 3. Calculer la MOYENNE par pays
# na.rm = TRUE est CRUCIAL : cela ignore les trous.
# Si un pays a son PIB en 2015 et 2016 mais pas 2017, on fait la moyenne de ce qu'on a.
df_moyenne <- df_10ans %>%
group_by(ISO3) %>%
summarise(
# On fait la moyenne de toutes les variables numériques
GDP_USD_Mean = mean(GDP_USD, na.rm = TRUE),
Population_Mean = mean(Population_Total, na.rm = TRUE),
Health_Exp_Percent_Mean = mean(Health_Exp_Percent_GDP, na.rm = TRUE),
Polity_Score_Mean = mean(Polity_Score, na.rm = TRUE),
Inactivity_Adolescents_Mean = mean(Inactivity_Adolescents_Percent, na.rm = TRUE),
GDP_per_Capita_Mean = mean(GDP_per_Capita, na.rm = TRUE),
Health_Exp_USD_Mean = mean(Health_Exp_per_Capita_USD, na.rm = TRUE),
Log_Pop_Mean = mean(Log_Population, na.rm = TRUE),
Log_GDP_Cap_Mean = mean(Log_GDP_per_Capita, na.rm = TRUE)
)
# 4. Créer la variable "Pays Hôte 2024" proprement
# On ne fait pas la moyenne (sinon la France aurait 0.1), on met 1 si c'est la France.
df_moyenne <- df_moyenne %>%
mutate(Is_Host_2024 = ifelse(ISO3 == "FRA", 1, 0))
# 5. Nettoyage final (Retirer les lignes où tout est vide ou NaN)
# Parfois le calcul de moyenne renvoie NaN si toutes les années sont vides
df_moyenne <- df_moyenne %>%
filter(!is.nan(GDP_USD_Mean))
# 6. Sauvegarder le résultat final
write.csv(df_moyenne, "Dataset_Final_Moyenne_10ans.csv", row.names = FALSE)
# Vérification
print(head(df_moyenne))
print(paste("Nombre de pays dans la base finale :", nrow(df_moyenne)))
