# Définition des paramètres
set.seed(123)  # Pour la reproductibilité
N <- 1000  # Taille réelle de la population
M <- 50    # Nombre de poissons marqués
n <- 100   # Nombre de poissons recapturés
# Étape 1 : Création de la population avec marquage
population <- c(rep(1, M), rep(0, N - M))  # 1 = marqué, 0 = non marqué
# Étape 2 : Échantillonnage pour la recapture
recapture <- sample(population, n, replace = TRUE)
X <- sum(recapture)  # Nombre de poissons marqués recapturés
# Étape 3 : Estimation de la taille de la population
if (X > 0) {
N_hat <- (n * M) / X  # Estimateur de N
} else {
N_hat <- NA  # Cas où aucun poisson marqué n'est recapturé
}
# Affichage du résultat
cat("Estimation de la population N :", N_hat, "\n")
# Étape 4 : Simulation sur plusieurs itérations
simulations <- 1000
N_estimations <- numeric(simulations)
for (i in 1:simulations) {
recapture <- sample(population, n, replace = TRUE)
X <- sum(recapture)
if (X > 0) {
N_estimations[i] <- (n * M) / X
} else {
N_estimations[i] <- NA
}
}
# Affichage des résultats
hist(N_estimations, breaks = 30, main = "Distribution des estimations de N", xlab = "Estimation de N", col = "lightblue", border = "black")
